# Copy to .env and fill in. Real keys are never committed.

# Supabase project URL (FOGO production project)
SUPABASE_URL=https://avlhnogtosjxdyibjipz.supabase.co

# Anon / publishable key (sb_publishable_...). SELECT-only via RLS; used at
# build time only — it is never shipped in client JS.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Which brand this build produces. Must match public.brand_sites.slug.
BRAND_SLUG=bean-envy

# Secret key (sb_secret_...). Locally: scripts (mirror-images, attribution-*).
# On Vercel: the email-capture functions in api/ (Sensitive env var, never
# PUBLIC_-prefixed). Never used by the static site build. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Email capture (api/*.js; EMAIL_CAPTURE_SCOPE_v1.md). Set on each brand's
# Vercel project that has email turned on, as Sensitive env vars.
# POSTMARK_SERVER_TOKEN: that brand's Postmark *server* API token.
# EMAIL_TOKEN_PEPPER: long random string (e.g. `openssl rand -base64 32`);
#   hashes confirm tokens and IPs. Changing it invalidates pending confirm links.
POSTMARK_SERVER_TOKEN=
EMAIL_TOKEN_PEPPER=
# Drip (Phase 2). CRON_SECRET: random string; Vercel sends it to /api/drip-tick
# as a Bearer token. POSTMARK_WEBHOOK_USER/PASS: basic-auth credentials in the
# Postmark webhook URL. POSTMARK_BROADCAST_STREAM: ID of the broadcast stream
# on the brand's Postmark server (default "drip").
CRON_SECRET=
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=
POSTMARK_BROADCAST_STREAM=drip
# Preview-only: 1 turns signup forms/pages on regardless of
# brand_sites.email_enabled (test on a preview deploy before going live).
EMAIL_FORCE_ENABLE=

# Google Ads (scripts/ads-push.mjs only). OAuth client + refresh token for a user on the
# FOGO manager account; the client account per brand is brand_sites.google_ads_customer_id.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
