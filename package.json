{
  "name": "fogo-brand-sites",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Per-brand static marketing sites for the FOGO Brands portfolio. One repo, one template, N builds selected via BRAND_SLUG.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-blog.mjs && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "mirror-images": "node scripts/mirror-images.mjs",
    "check:blog": "node scripts/check-blog.mjs",
    "attribution-tags": "node scripts/attribution-tags.mjs",
    "attribution-report": "node scripts/attribution-report.mjs",
    "ads:campaigns": "node scripts/ads-campaigns.mjs",
    "ads:push": "node scripts/ads-push.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.0",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/figtree": "^5.2.10",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/michroma": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/zilla-slab": "^5.3.0",
    "astro": "^5.1.1",
    "tailwindcss": "^3.4.17",
    "yaml": "^2.9.1"
  }
}
