---
// "Guides for this product" — blog posts whose related_asins include an ASIN
// of the family being viewed. Renders nothing when there are none, so brands
// without a blog are untouched. Props: posts (from getBlogPosts()).
import { formatPostDate } from '../lib/content.js';

const { posts = [] } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-10" aria-labelledby="pdp-guides-heading">
      <h2 id="pdp-guides-heading" class="text-2xl font-extrabold tracking-tight">
        Guides for this product
      </h2>
      <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <li class="rounded-2xl border border-black/10 bg-[var(--surface)] p-5">
            <p class="text-sm text-black/60">
              <time datetime={p.date}>{formatPostDate(p.updated ?? p.date)}</time>
            </p>
            <a
              href={`/blog/${p.slug}/`}
              class="mt-1 block text-lg font-extrabold leading-snug underline-offset-4 hover:underline"
            >
              {p.title}
            </a>
            <p class="mt-2 text-sm text-black/70">{p.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
