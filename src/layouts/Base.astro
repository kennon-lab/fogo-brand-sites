---
import '../styles/tokens.css';
import '../styles/global.css';
// Registered brand fonts — self-hosted at build time, so no external font
// requests at runtime. Unused @font-face rules cost only CSS bytes (browsers
// download only fonts the page actually renders). Adding a font for a new
// brand = `npm i @fontsource/<font>` + one import here.
import '@fontsource/archivo-black';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/michroma';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/500-italic.css';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '@fontsource/fira-sans-condensed/600.css';
import '@fontsource/fira-sans-condensed/800.css';
import '@fontsource/fira-sans/400.css';
import '@fontsource/fira-sans/600.css';
import '@fontsource/fira-sans/800.css';
import '@fontsource/zilla-slab/600.css';
import '@fontsource/zilla-slab/700.css';
import '@fontsource/barlow-semi-condensed/400.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource/barlow-semi-condensed/700.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getBrand, getPaidLinks, BLOG_CHANNEL } from '../lib/supabase.js';
import { localBucketImage } from '../lib/images.js';

const brand = await getBrand();

// Paid-channel attribution tags (public.brand_site_paid_links). Embedded as
// JSON and applied client-side by the swap script below when the visitor
// arrived from a paid click, so Amazon Attribution reports paid vs organic
// separately. Empty for brands with no paid tags yet → nothing is emitted.
// brand_site_blog is organic (blog pages bake it into their CTAs at build), so
// it stays out of the client-side paid map.
const paidLinks = Object.fromEntries(
  [...(await getPaidLinks())]
    .map(([asin, byChannel]) => [asin, Object.fromEntries(Object.entries(byChannel).filter(([c]) => c !== BLOG_CHANNEL))])
    .filter(([, byChannel]) => Object.keys(byChannel).length > 0)
);
const hasPaidLinks = Object.keys(paidLinks).length > 0;

// Per-brand favicon (bucket-relative path, localized at build like all other
// bucket images). Brands without favicon_path emit no icon links — unchanged.
const favicon = brand.favicon_path ? await localBucketImage(brand.favicon_path, 64, 'png') : null;
const appleTouchIcon = brand.favicon_path ? await localBucketImage(brand.favicon_path, 180, 'png') : null;

const {
  title,
  description = brand.tagline ?? `${brand.brand} — shop our products on Amazon.`,
  ogImage = null,
  ogType = 'website', // 'article' for blog posts
  jsonLd = null,
  // GA4 outbound_amazon_click dimension; every page sets its own
  // (home | pdp | collection | catalog | about | contact | privacy).
  pageType = 'page',
} = Astro.props;

const pageTitle = title ? `${title} | ${brand.brand}` : `${brand.brand} — ${brand.tagline ?? 'Official Site'}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageAbs = ogImage ? new URL(ogImage, Astro.site).href : null;

// Brand identity stylesheet: when src/styles/brands/<slug>.css exists it owns
// the full token set (colors AND fonts), so the DB-driven :root injection is
// skipped entirely — the stylesheet is inlined in its place, same cascade
// position, so it wins over tokens.css defaults exactly like themeVars did.
// Brands without a stylesheet (e.g. bean-envy) are untouched.
const brandCssFiles = import.meta.glob('../styles/brands/*.css', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const brandCss = brandCssFiles[`../styles/brands/${brand.slug}.css`] ?? null;

const primary = brand.primary_color ?? '#171310';
const secondary = brand.secondary_color ?? '#5b5147';
const systemStack = `system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif`;
const fontHeading = brand.font_heading ? `'${brand.font_heading}', ${systemStack}` : systemStack;
const fontBody = brand.font_body ? `'${brand.font_body}', ${systemStack}` : systemStack;
const themeVars = brandCss ?? `:root{--brand:${primary};--brand-2:${secondary};--font-heading:${fontHeading};--font-body:${fontBody};}`;

const gaId = brand.google_analytics_id;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {favicon && <link rel="icon" type="image/png" href={favicon} />}
    {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
    <style set:html={themeVars}></style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Amazon CTAs open a new tab on desktop but hand off in the same tab on
         touch devices (Amazon-app friendly). Runs with or without GA. -->
    <script
      set:html={`document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[data-amazon-cta]');if(a&&window.matchMedia('(pointer: coarse)').matches){a.target='_self';}});`}
    />
    <!-- Paid-traffic attribution. A landing from a Google Ads click (gclid /
         gbraid / wbraid, or utm_source=google + utm_medium=cpc) is remembered
         for the session; every Amazon CTA then swaps to the brand's
         'google_ads' Amazon Attribution tag for that ASIN, with any ValueTrack
         placeholders ({campaignid} {adgroupid} {creative} {keyword} …) filled
         from the landing URL. A MutationObserver re-applies the swap when a
         variant switcher rewrites a CTA href. No network, no cookies; the
         sessionStorage write is best-effort. -->
    {hasPaidLinks && <script type="application/json" id="fogo-paid-links" set:html={JSON.stringify(paidLinks)} />}
    <script
      set:html={`(function(){try{var q=new URLSearchParams(location.search);var KEYS=['gclid','gbraid','wbraid','campaignid','adgroupid','creative','keyword','matchtype','device','network','targetid','loc_physical_ms','utm_campaign','utm_content','utm_term'];var src=(q.get('utm_source')||'').toLowerCase(),med=(q.get('utm_medium')||'').toLowerCase();var paid=q.has('gclid')||q.has('gbraid')||q.has('wbraid')||(src==='google'&&/^(cpc|ppc|paid|paidsearch)$/.test(med));var S=null;if(paid){S={channel:'google_ads',params:{},ts:Date.now()};for(var i=0;i<KEYS.length;i++){if(q.has(KEYS[i]))S.params[KEYS[i]]=q.get(KEYS[i]);}try{sessionStorage.setItem('fogoPaid',JSON.stringify(S));}catch(e){}}else{try{var raw=sessionStorage.getItem('fogoPaid');if(raw)S=JSON.parse(raw);}catch(e){}}if(!S)return;window.fogoPaid=S;var el=document.getElementById('fogo-paid-links');var map=el?JSON.parse(el.textContent):{};function resolve(asin){var by=map[asin];var url=by&&by[S.channel];if(!url)return null;return url.replace(/\\{(\\w+)\\}|%7B(\\w+)%7D/g,function(m,a,b){return encodeURIComponent(S.params[a||b]||'');});}window.fogoResolveCta=function(asin,fallback){return resolve(asin)||fallback;};function apply(a){var u=resolve(a.dataset.asin||'');if(u&&a.getAttribute('href')!==u){a.href=u;a.dataset.ctaChannel=S.channel;}}function swapAll(){var as=document.querySelectorAll('a[data-amazon-cta][data-asin]');for(var i=0;i<as.length;i++)apply(as[i]);if(window.MutationObserver){new MutationObserver(function(ms){for(var j=0;j<ms.length;j++){var t=ms[j].target;if(t&&t.matches&&t.matches('a[data-amazon-cta][data-asin]'))apply(t);}}).observe(document.body,{attributes:true,attributeFilter:['href','data-asin'],subtree:true});}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',swapAll);else swapAll();}catch(e){}})();`}
    />
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');
document.addEventListener('click',function(e){var a=e.target.closest('a[data-amazon-cta]');if(!a)return;var p={asin:a.dataset.asin||'',page_type:(document.body&&document.body.dataset.pageType)||'',cta_position:a.dataset.ctaPosition||'',cta_channel:a.dataset.ctaChannel||'organic',link_url:a.href};gtag('event','outbound_amazon_click',p);gtag('event','amazon_click',{asin:p.asin,link_url:p.link_url,cta_channel:p.cta_channel});});`}
          />
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased" data-page-type={pageType}>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
