---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import BlogCta from '../../components/BlogCta.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getBrand } from '../../lib/supabase.js';
import { getLocalImagesByAsin, localBucketImage } from '../../lib/images.js';
import { getBlogPosts, getMergedCatalog, formatPostDate } from '../../lib/content.js';

// The blog exists only for brands with posts in
// src/content/brands/<slug>/blog/ — every other brand builds no /blog/ routes
// at all (same gating idiom as warranty/[...path].astro). One rest route
// serves both the index (slug undefined) and each post.
export async function getStaticPaths() {
  const posts = await getBlogPosts();
  if (posts.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { mode: 'index' } },
    ...posts.map((post) => ({ params: { slug: post.slug }, props: { mode: 'post', postSlug: post.slug } })),
  ];
}

const { mode, postSlug } = Astro.props;
const brand = await getBrand();
const posts = await getBlogPosts();

// Index data: every post with its localized hero.
const cards =
  mode === 'index'
    ? await Promise.all(
        posts.map(async (p) => ({
          ...p,
          hero: p.hero_image_path ? await localBucketImage(p.hero_image_path, 900) : null,
        }))
      )
    : [];

// Post data.
const post = mode === 'post' ? posts.find((p) => p.slug === postSlug) : null;
const hero = post?.hero_image_path ? await localBucketImage(post.hero_image_path, 1400) : null;

// Body HTML. The glob loader pre-renders markdown into entry.rendered.html;
// we split it at H2 boundaries so product cards can be injected after the
// intro and at the end of named sections (post.cta_after_sections). Falls
// back to the plain <Content /> component if rendered HTML is ever absent.
const bodyHtml = post?.entry.rendered?.html ?? null;
const { Content } = post && !bodyHtml ? await render(post.entry) : { Content: null };

const decode = (s) =>
  s
    .replace(/<[^>]+>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&#x27;|&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
// Smart quotes: the markdown pipeline typographic-quotes the rendered heading
// while cta_after_sections is authored with straight quotes.
const norm = (s) => decode(s).toLowerCase().replace(/[\u2018\u2019]/g, "'").replace(/[\u201c\u201d]/g, '"').replace(/\s+/g, ' ').trim();

// [{ heading: 'What you'll need' | null, html }] — segment 0 is the intro.
const sections = bodyHtml
  ? bodyHtml.split(/(?=<h2[\s>])/).map((html) => {
      const m = html.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
      return { heading: m ? norm(m[1]) : null, html };
    })
  : [];
const ctaAfter = new Set((post?.cta_after_sections ?? []).map(norm));
for (const h of ctaAfter) {
  if (!sections.some((s) => s.heading === h)) {
    throw new Error(`[blog] "${post.slug}": cta_after_sections heading "${h}" not found among the post's H2s.`);
  }
}

// Related products: one card per catalog family containing a listed ASIN, in
// the order authored. ASINs missing from the live catalog are skipped.
let related = [];
let imagesByAsin = new Map();
let primary = null; // { product, group, images } for the inline cards
if (post && post.related_asins.length > 0) {
  const merged = await getMergedCatalog();
  imagesByAsin = await getLocalImagesByAsin();
  const seen = new Set();
  for (const asin of post.related_asins) {
    const group = merged.find((g) => g.children.some((c) => c.asin === asin));
    if (!group) {
      console.warn(`[blog] "${post.slug}": related ASIN ${asin} is not in the live catalog — skipped.`);
      continue;
    }
    if (seen.has(group.key)) continue;
    seen.add(group.key);
    related.push(group);
  }
  const primaryAsin = post.primary_asin ?? post.related_asins[0];
  const group = merged.find((g) => g.children.some((c) => c.asin === primaryAsin));
  if (group) {
    const product = group.children.find((c) => c.asin === primaryAsin);
    primary = {
      product,
      group,
      images: imagesByAsin.get(product.asin) ?? imagesByAsin.get(group.representative.asin) ?? [],
    };
  } else {
    console.warn(`[blog] "${post.slug}": primary ASIN ${primaryAsin} is not in the live catalog — inline CTAs omitted.`);
  }
}
const showEarlyCta = Boolean(primary && post.cta_early && sections.length > 0 && sections[0].html.trim() !== '');

// Index intro copy per brand ({ meta, lede }); brands not listed get the
// generic line.
const BLOG_INTROS = {
  'otis-classic': {
    meta: `Guides, recipes and ideas from ${brand.brand}.`,
    lede: 'Guides, recipes and ideas to help you get more out of your kitchen.',
  },
  'amazing-shields': {
    meta: `Guides and tips for cat owners from ${brand.brand}.`,
    lede: 'Guides and tips for a happy cat and a scratch-free home.',
  },
};
const blogIntro = BLOG_INTROS[brand.slug] ?? {
  meta: `Guides, tips and ideas from ${brand.brand}.`,
  lede: `Guides, tips and ideas from the ${brand.brand} team.`,
};

const morePosts = post ? posts.filter((p) => p.slug !== post.slug).slice(0, 3) : [];

// Structured data: BlogPosting + BreadcrumbList (+ FAQPage when the post has
// an FAQ). Products featured in the post are listed as `mentions` with their
// PDP URLs so the article ↔ product relationship is explicit to crawlers.
const postUrl = post ? new URL(Astro.url.pathname, Astro.site).href : null;
const pdpHref = (group) => (group.slug ? `/products/${group.slug}/` : `/products/${group.representative.asin}/`);
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          '@id': `${postUrl}#article`,
          headline: post.title,
          description: post.description,
          ...(post.summary && { abstract: post.summary }),
          keywords: [post.target_keyword, ...post.secondary_keywords].join(', '),
          datePublished: post.date,
          dateModified: post.updated ?? post.date,
          author: post.author
            ? { '@type': 'Person', name: post.author, worksFor: { '@type': 'Organization', name: brand.brand } }
            : { '@type': 'Organization', name: brand.brand },
          publisher: { '@type': 'Organization', name: brand.brand, url: new URL('/', Astro.site).href },
          mainEntityOfPage: postUrl,
          inLanguage: 'en-US',
          ...(hero ? { image: new URL(hero, Astro.site).href } : {}),
          ...(related.length > 0 && {
            mentions: related.map((group) => ({
              '@type': 'Product',
              name: group.authored?.display_name ?? group.representative.display_title,
              url: new URL(pdpHref(group), Astro.site).href,
            })),
          }),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: brand.brand, item: new URL('/', Astro.site).href },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
            { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
          ],
        },
        ...(post.faq.length > 0
          ? [
              {
                '@type': 'FAQPage',
                '@id': `${postUrl}#faq`,
                mainEntity: post.faq.map((f) => ({
                  '@type': 'Question',
                  name: f.q,
                  acceptedAnswer: { '@type': 'Answer', text: f.a },
                })),
              },
            ]
          : []),
      ],
    }
  : null;
---

{
  mode === 'index' ? (
    <Base
      title="Blog"
      description={blogIntro.meta}
      ogImage={cards.find((c) => c.hero)?.hero ?? null}
      pageType="blog"
    >
      <section class="mx-auto max-w-6xl px-4 py-14">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">The {brand.brand} blog</h1>
        <p class="mt-3 max-w-2xl text-lg text-black/70">{blogIntro.lede}</p>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((card) => (
            <article class="group flex flex-col overflow-hidden rounded-2xl border border-black/10 bg-[var(--surface)] shadow-sm hover:shadow-md transition-shadow">
              <a href={`/blog/${card.slug}/`} class="block no-underline" tabindex="-1" aria-hidden="true">
                {card.hero ? (
                  <img
                    src={card.hero}
                    alt=""
                    width="900"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[2/1] w-full object-cover"
                  />
                ) : (
                  <div class="aspect-[2/1] w-full bg-[var(--brand)]" />
                )}
              </a>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-sm text-black/60">
                  <time datetime={card.date}>{formatPostDate(card.date)}</time>
                </p>
                <h2 class="mt-2 text-xl font-extrabold leading-snug tracking-tight">
                  <a href={`/blog/${card.slug}/`} class="no-underline hover:underline underline-offset-4">
                    {card.title}
                  </a>
                </h2>
                <p class="mt-3 text-black/70">{card.description}</p>
                <a
                  href={`/blog/${card.slug}/`}
                  class="mt-auto pt-5 font-bold underline underline-offset-4 decoration-[var(--brand)] decoration-2"
                  aria-label={`Read: ${card.title}`}
                >
                  Read more →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </Base>
  ) : (
    <Base
      title={post.title}
      description={post.description}
      ogImage={hero}
      ogType="article"
      jsonLd={jsonLd}
      pageType="blog-post"
    >
      <article>
        <header class="mx-auto max-w-3xl px-4 pt-10">
          <nav class="text-sm text-black/60" aria-label="Breadcrumb">
            <a href="/blog/" class="hover:underline underline-offset-4">Blog</a>
            <span aria-hidden="true"> / </span>
            <span>{post.title}</span>
          </nav>
          <h1 class="mt-6 text-3xl sm:text-5xl font-extrabold leading-tight tracking-tight">{post.title}</h1>
          <p class="mt-4 text-sm text-black/60">
            {post.author && <span>By {post.author} · </span>}
            <time datetime={post.date}>{formatPostDate(post.date)}</time>
            {post.updated && post.updated !== post.date && (
              <span>
                {' · Updated '}
                <time datetime={post.updated}>{formatPostDate(post.updated)}</time>
              </span>
            )}
          </p>
        </header>
        {hero && (
          <div class="mx-auto max-w-5xl px-4 pt-8">
            <img
              src={hero}
              alt={post.hero_alt ?? ''}
              width="1400"
              height="700"
              fetchpriority="high"
              decoding="async"
              class="aspect-[2/1] w-full rounded-3xl object-cover shadow-md"
            />
          </div>
        )}
        {post.summary && (
          <div class="mx-auto max-w-3xl px-4 pt-8">
            <div class="rounded-2xl border-l-4 border-[var(--brand)] bg-[var(--surface)] p-5 shadow-sm sm:p-6">
              <p class="text-xs font-bold uppercase tracking-wide text-black/50">Quick answer</p>
              <p class="mt-2 text-lg leading-relaxed">{post.summary}</p>
            </div>
          </div>
        )}
        <div class="prose-post mx-auto max-w-3xl px-4 py-10 text-lg text-black/80">
          {bodyHtml ? (
            sections.map((section, i) => (
              <>
                <Fragment set:html={section.html} />
                {i === 0 && showEarlyCta && (
                  <BlogCta product={primary.product} group={primary.group} images={primary.images} variant="early" />
                )}
                {i > 0 && primary && section.heading && ctaAfter.has(section.heading) && (
                  <BlogCta product={primary.product} group={primary.group} images={primary.images} variant="mid" />
                )}
              </>
            ))
          ) : (
            <Content />
          )}
        </div>
        {post.faq.length > 0 && (
          <section class="mx-auto max-w-3xl px-4 pb-12" aria-labelledby="post-faq-heading">
            <h2 id="post-faq-heading" class="text-2xl font-extrabold tracking-tight">
              Frequently asked questions
            </h2>
            <div class="mt-4">
              <FaqAccordion items={post.faq.map((f) => ({ question: f.q, answer: f.a }))} />
            </div>
          </section>
        )}
      </article>

      {related.length > 0 && (
        <section class="border-t border-black/10 bg-[var(--surface)]">
          <div class="mx-auto max-w-6xl px-4 py-14">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Featured in this post</h2>
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((group) => (
                <ProductCard
                  representative={group.representative}
                  children={group.children}
                  images={imagesByAsin.get(group.representative.asin) ?? []}
                  labels={group.labels}
                />
              ))}
            </div>
          </div>
        </section>
      )}

      {morePosts.length > 0 && (
        <section class="mx-auto max-w-3xl px-4 py-14">
          <h2 class="text-2xl font-extrabold tracking-tight">Keep reading</h2>
          <ul class="mt-6 space-y-4">
            {morePosts.map((p) => (
              <li>
                <a
                  href={`/blog/${p.slug}/`}
                  class="text-lg font-bold underline underline-offset-4 decoration-[var(--brand)] decoration-2"
                >
                  {p.title}
                </a>
                <p class="mt-1 text-black/70">{p.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </Base>
  )
}
